# Copy to .env to override defaults. Every variable is optional; the defaults run the
# service against the local mock provider. Never commit a real .env (it is git-ignored).

# --- service ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
DB_PATH=data/voice_agent.db
LOG_LEVEL=INFO
# Persistence: sqlite (default) or dynamodb (AWS; credentials from the standard AWS chain)
STORE_BACKEND=sqlite
# DYNAMODB_TABLE=collectionsinference-state
# AWS_REGION=ap-south-1
TURN_DEADLINE_S=6.0
HANDOFF_AFTER_DEGRADED=2
SWEEP_INTERVAL_S=30
# FALLBACK_AUDIO_DIR=prompts/   # pre-recorded retry_prompt.wav / handoff.wav

# --- resilience --------------------------------------------------------------
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_S=0.1
RETRY_MAX_DELAY_S=2.0
BREAKER_WINDOW=50
BREAKER_MINIMUM_CALLS=20
BREAKER_FAILURE_THRESHOLD=0.6
BREAKER_OPEN_S=5.0
BREAKER_HALF_OPEN_CALLS=5

# --- providers: "mock" (local mock) or "openai" (OpenAI-compatible open-weight server)
STT_PROVIDER=mock
STT_BASE_URL=http://127.0.0.1:9000/v1
STT_MODEL=Systran/faster-whisper-small
STT_TIMEOUT_S=1.5
STT_API_KEY=

LLM_PROVIDER=mock
LLM_BASE_URL=http://127.0.0.1:9000/v1
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_S=3.0
LLM_API_KEY=

TTS_PROVIDER=mock
TTS_BASE_URL=http://127.0.0.1:9000/v1
TTS_MODEL=kokoro
TTS_VOICE=af_bella
TTS_TIMEOUT_S=1.5
TTS_API_KEY=

# --- mock provider -------------------------------------------------------------
MOCK_FAILURE_RATE=0.2
# MOCK_SEED=42
MOCK_LATENCY_SCALE=1.0
MOCK_HANG_S=10
